<div class="mt-8">
    <div class="flex items-baseline justify-between mx-4">
        <h2 class="text-2xl text-white font-bold">Where the matches sit in time</h2>
        <span class="text-xs text-gray-400">now &rarr; 130,000 years ago</span>
    </div>

    <div class="flex justify-between mx-4 mt-3 text-[10px] uppercase tracking-wide text-gray-500">
        <span>now</span>
        <span>130,000 years ago</span>
    </div>

    <div class="mt-2 space-y-1">
        {% for point in timeline.points %}
            <div class="flex items-center gap-3 px-3 py-1.5 rounded-md {{ point.rank == 1 ? 'bg-emerald-900/30 ring-1 ring-emerald-500/40' : 'hover:bg-white/5' }}">
                <span class="w-8 shrink-0 text-right font-mono text-xs {{ point.rank == 1 ? 'text-emerald-300' : 'text-gray-500' }}">#{{ point.rank }}</span>

                <img src="{{ point.imageUrl }}"
                     alt="{{ point.findId }}"
                     title="{{ point.summary }}"
                     class="h-10 w-10 shrink-0 rounded object-cover {{ point.rank == 1 ? 'ring-2 ring-emerald-400' : 'ring-1 ring-white/10' }}"/>

                <span class="w-28 shrink-0 font-mono text-xs {{ point.rank == 1 ? 'text-emerald-300' : 'text-gray-400' }}">{{ point.period }}</span>

                <div class="relative h-1.5 flex-1 rounded bg-gray-800">
                    {% if point.position is not null %}
                        <span class="absolute top-1/2 h-2.5 w-2.5 -translate-x-1/2 -translate-y-1/2 rounded-full {{ point.rank == 1 ? 'bg-emerald-400' : 'bg-gray-400' }}"
                              style="left: {{ point.position }}%"></span>
                    {% endif %}
                </div>

                <span class="hidden w-1/3 truncate text-right text-xs text-gray-500 lg:block" title="{{ point.summary }}">{{ point.summary }}</span>
            </div>
        {% endfor %}
    </div>
</div>
